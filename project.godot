; BEYOND THE HORIZON: FINDING PEACE
; Godot 4 project - Forward+ renderer, PC first.
config_version=5

[application]

config/name="Beyond The Horizon: Finding Peace"
config/description="Cinematic historical open-world exploration benchmark."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
toggle_help={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
; Keep desktop on Forward+, but use Godot Mobile renderer on Android/mobile exports.
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/anisotropic_filtering_level.mobile=2
lights_and_shadows/directional_shadow/size=4096
; Reduce mobile shadow atlas cost without changing desktop shadow quality.
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.36, 0.46, 0.55, 1)
occlusion_culling/use_occlusion_culling=true
